# Minimal diagnostic ELF build; uses headers only, never the SDK's crt1.o.
# make -f Makefile.ps4 PS4_PAYLOAD_SDK=/opt/ps4-payload-sdk
PS4_PAYLOAD_SDK ?= /opt/ps4-payload-sdk
CC := clang
LD := ld.lld
CFLAGS := --target=x86_64-unknown-freebsd9 -std=c11 -Wall -Wextra -Werror -O2 -g0
CFLAGS += -ffreestanding -fno-builtin -fno-stack-protector -fPIE
CFLAGS += -isystem $(PS4_PAYLOAD_SDK)/target/include -Iinclude -Iplatform/ps4
LDFLAGS := -m elf_x86_64 -pie -e _start -T platform/ps4/probe.ld -z max-page-size=0x4000
.PHONY: all
all: build/ps4/dualsense4hen-bt-probe.elf build/ps4/dualsense4hen-usb-probe.elf build/ps4/dualsense4hen-bt-observer.elf build/ps4/vda.o
build/ps4:
	mkdir -p $@
build/ps4/%.o: platform/ps4/%.c | build/ps4
	$(CC) $(CFLAGS) -c $< -o $@
build/ps4/usb-main.o: platform/ps4/probe.c | build/ps4
	$(CC) $(CFLAGS) -DD4H_USB_PROBE -c $< -o $@
build/ps4/bt-main.o: platform/ps4/probe.c | build/ps4
	$(CC) $(CFLAGS) -DD4H_BT_OBSERVER -c $< -o $@
build/ps4/hid.o: src/hid.c | build/ps4
	$(CC) $(CFLAGS) -c $< -o $@
build/ps4/ps4_pad.o: src/ps4_pad.c | build/ps4
	$(CC) $(CFLAGS) -c $< -o $@
build/ps4/dualsense4hen-bt-probe.elf: build/ps4/runtime.o build/ps4/probe.o platform/ps4/probe.ld
	$(LD) $(LDFLAGS) build/ps4/runtime.o build/ps4/probe.o -o $@
build/ps4/dualsense4hen-usb-probe.elf: build/ps4/runtime.o build/ps4/usb-main.o build/ps4/usb_probe.o build/ps4/hid.o build/ps4/ps4_pad.o platform/ps4/probe.ld
	$(LD) $(LDFLAGS) build/ps4/runtime.o build/ps4/usb-main.o build/ps4/usb_probe.o build/ps4/hid.o build/ps4/ps4_pad.o -o $@
build/ps4/dualsense4hen-bt-observer.elf: build/ps4/runtime.o build/ps4/bt-main.o build/ps4/bt_observer.o build/ps4/hid.o platform/ps4/probe.ld
	$(LD) $(LDFLAGS) build/ps4/runtime.o build/ps4/bt-main.o build/ps4/bt_observer.o build/ps4/hid.o -o $@
